# Environment variables for local development
# Copy this file to .env.local and fill in the required values

# Neon database connection (required)
# Get this from your Neon project dashboard
DATABASE_URL=your-neon-connection-string

# NextAuth (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-generate-with-openssl
AUTH_URL=http://localhost:3000

# Google Maps API (required)
# Get this from https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Cloudflare R2 dish photos (S9). When unset, uploads use local .uploads/
# storage via /api/uploads/local — fine for solo/dev; set these for production.
# Serving choice: public bucket via R2_PUBLIC_URL (custom domain or r2.dev).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=the-usual-photos
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Optional PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=your-posthog-host
